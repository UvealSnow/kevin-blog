{
	"extends": "../tsconfig.base.json",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@components/*": ["src/components/*"],
			"@icons/*": ["src/icons/*"],
			"@utils/*": ["src/utils/*"],
			"@src/*": ["src/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
