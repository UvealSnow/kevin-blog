---
import MainLayout from '@components/layouts/MainLayout.astro'
import Author from '@components/author.astro'
import SyntaxHighlighter from '@components/SyntaxHighlighter.astro'
import { get } from '@src/cms'
import type { PostAuthor, PostTranslation, Translation } from '@src/types'
import { formatDate } from '@src/utils'

const { locale, slug } = Astro.params

interface Post {
	date_created: string
	translations: PostTranslation[]
	user_created: PostAuthor
}

export async function getStaticPaths() {
	const { data } = await get<Translation[]>('items/posts', {
		filter: {
			status: {
				_eq: 'published',
			},
		},
		fields: ['translations.slug', 'translations.languages_code'],
	})

	return data.flatMap((entry) =>
		entry.translations.map((translation) => {
			const { languages_code: locale, slug } = translation
			return {
				params: { locale, slug },
			}
		}),
	)
}

const { data } = await get<Post[]>('items/posts', {
	filter: {
		_and: [
			{
				translations: {
					slug: {
						_eq: slug,
					},
				},
			},
			{
				translations: {
					languages_code: {
						_eq: locale,
					},
				},
			},
		],
	},
	fields: [
		'translations.*',
		'date_created',
		'user_created.first_name',
		'user_created.last_name',
		'user_created.email',
		'user_created.location',
		'user_created.title',
		'user_created.description',
		'user_created.avatar',
	],
})

const { user_created: author, translations, date_created } = data[0]
const postTranslation = translations.find((t) => t.languages_code === locale)!
const createdAt = formatDate(date_created)
---

<MainLayout locale={locale} title={postTranslation.name} description="">
	<slot slot="head">
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/tokyo-night-dark.min.css"
		/>
	</slot>

	<h1 class="text-5xl leading-15">{postTranslation.name}</h1>
	<p class="text-xs mt-2 mb-8">First published: {createdAt}</p>
	<Author author={author} />
	<div id="post" set:html={postTranslation.content} />
	<SyntaxHighlighter languages={['dockerfile', 'typescript']} />
</MainLayout>
