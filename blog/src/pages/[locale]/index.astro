---
import MainLayout from '@components/layouts/MainLayout.astro'

export function getStaticPaths() {
	return [
		{ params: { locale: 'en-US' } },
		{ params: { locale: 'es-ES' } }
	]
}

const { locale } = Astro.params
---

<MainLayout locale={locale} title="i18n page title" description="i18n description">
	<h1>Index: {locale}</h1>
</MainLayout>
