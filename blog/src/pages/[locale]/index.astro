---
import MainLayout from '@components/layouts/MainLayout.astro'
import type { GetStaticPaths } from 'astro'
import { readCache } from '@kevhah/i18n'

export const getStaticPaths = (async () => {
	const { availableLocales } = readCache()
	return availableLocales.map((locale: string) => ({ params: { locale } }))
}) satisfies GetStaticPaths

const { t } = Astro.locals
const { locale } = Astro.params
---

<MainLayout title={t('index.title')} description={t('index.description')} locale={locale}>
	<h1 class="font-bold text-5xl">{t('index.header')}</h1>
</MainLayout>
