---
import MainLayout from '@components/layouts/MainLayout.astro'
import { get } from '@src/cms'
import type { Translation, PageTranslation } from '@src/types'
import { formatDate } from '@src/utils'

const { locale, slug } = Astro.params
const { t } = Astro.locals

interface Page {
	date_updated: string
	translations: PageTranslation[]
}

export async function getStaticPaths() {
	const { data } = await get<Translation[]>('items/pages', {
		filter: {
			status: {
				_eq: 'published',
			},
		},
		fields: ['translations.slug', 'translations.languages_code'],
	})

	return data.flatMap((entry) =>
		entry.translations.map((translation) => {
			const { languages_code: locale, slug } = translation
			return {
				params: { locale, slug },
			}
		}),
	)
}

const { data } = await get<Page[]>('items/pages', {
	filter: {
		translations: {
			slug: {
				_eq: slug,
			},
		},
	},
	fields: ['date_updated', 'translations.*'],
})

const { translations, date_updated } = data[0]
const pageTranslation = translations.find((t) => t.languages_code === locale)!
const lastUpdated = formatDate(date_updated)
---

<MainLayout locale={locale} title={pageTranslation.name} description={pageTranslation.description}>
	<h1 class="text-5xl leading-15">{pageTranslation.name}</h1>
	<p class="text-xs mt-2 mb-8">{t('pages.lastUpdated')}: {lastUpdated}</p>

	<pre>
		{JSON.stringify(pageTranslation, null, 2)}
	</pre>
</MainLayout>
