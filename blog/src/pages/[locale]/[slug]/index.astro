---
import MainLayout from '@components/layouts/MainLayout.astro'
import type { GetStaticPaths } from 'astro'

interface PageTranslation {
	id: number
	pages_id: string
	languages_code: string
	name: string
	slug: string
	description: string
	thumbnail: string
}

interface PageResponse {
	id: string
	translations: PageTranslation[]
}

export const getStaticPaths = (async () => {
	const availableLanguages = ['en-US', 'es-ES']
	const response = await fetch(
		'http://localhost:8055/items/pages?filter[status]=published&fields=translations.*,id',
	)
	const json = await response.json()
	const data = json.data as PageResponse[]

	return data.flatMap((entry) =>
		entry.translations
			.filter((t) => availableLanguages.includes(t.languages_code))
			.map((t) => ({ params: { locale: t.languages_code, slug: t.slug } })),
	)
}) satisfies GetStaticPaths

const { locale, slug } = Astro.params
---

<MainLayout locale={locale} title={`i18n ${slug} title`} description="i18n description">
	<h1>{slug}@{locale}</h1>
</MainLayout>
