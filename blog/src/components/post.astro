---
import type { PostTranslation, PostAuthor } from '@src/types'
import Author from './author.astro'

interface Props {
	translations: PostTranslation[]
	author: PostAuthor
	createdAt: string
}

const { translations, author, createdAt } = Astro.props
const { locale } = Astro.params
const getPostURL = (locale: string, slug: string): URL => {
	return new URL(`${locale}/blog/${slug}`, process.env.BASE_URL ?? 'http://localhost:4321')
}
const postTranslation = translations.find((t) => t.languages_code === locale)!
const postUrl = getPostURL(locale!, postTranslation.slug)
---

<a href={postUrl.toString()}>
	<div class="flex flex-col gap-3
    cursor-pointer group">
		<h2 class="text-2xl
      group-hover:text-primary
      active:text-primary">
			{postTranslation.name}
		</h2>
		<p class="text-xs">Posted at: {createdAt}</p>

		<Author author={author} />

		{
			postTranslation.thumbnail && (
				<img class="rounded-lg w-96" src={postTranslation.thumbnail} alt={postTranslation.name} />
			)
		}

		<p class="max-w-2xl mt-4">{postTranslation.description}</p>
	</div>
</a>
