---
import { Image } from 'astro:assets'
import type { PostAuthor } from '@src/types'
import { asset } from '@src/cms'
import Location from '@src/icons/location.svg'

interface Props {
	author: PostAuthor
}

const { author } = Astro.props
const fullName = `${author.first_name} ${author.last_name}`
---

<div class="author flex flex-row items-center gap-4 my-8">
	<Image
		class="rounded-full w-16 h-16"
		src={asset(author.avatar).toString()}
		alt={fullName}
		width={100}
		height={100}
	/>

	<div class="flex flex-col justify-center max-w-lg">
		<h5 class="text-sm font-bold">{fullName} - {author.title}</h5>
		{
			author.location && (
				<span class="text-xs h-6 flex flex-row items-center">
					<Location class="inline h-4 w-4 mr-2" />
					{author.location}
				</span>
			)
		}
		<p class="text-xs font-light italic">{author.description}</p>
	</div>
</div>
