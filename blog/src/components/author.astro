---
import type { PostAuthor } from '../types'

interface Props {
	author: PostAuthor
}

const { author } = Astro.props
const fullName = `${author.first_name} ${author.last_name}`
---

<div class="author flex flex-row items-center gap-4 my-8">
	<img class="rounded-full w-10 h-10" src={author.avatar} alt={fullName} />

	<div class="flex flex-col justify-center">
		<p class="text-sm font-bold">{fullName}</p>
		<p class="text-xs">{author.description}</p>
	</div>
</div>
