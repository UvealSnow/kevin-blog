---
import { Image } from 'astro:assets'

const { title, description } = Astro.props
const pictureAlt = 'Carolina Rivera Luque - Placeholder'
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/experience', label: 'Experience' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/contact', label: 'Contact me' },
]
---

<nav
	id="navbar"
	class="transition-all duration-500
		flex flex-col flex-none items-center
		w-64 h-screen p-4 pt-8
		bg-primary text-white
		absolute -left-64 top-0
		md:relative md:left-0"
>
	<Image
		loading="eager"
		src="https://placehold.co/96"
		class="rounded-full"
		width={96}
		height={96}
		alt={pictureAlt}
	/>

	<h5 class="text-xl text-white pt-8">{title}</h5>
	<p class="text-xs text-center pt-4">{description}</p>

	<ul class="flex flex-col gap-4 text-center pt-8">
		{
			links.map((link) => (
				<li class="m-0">
					<a href={link.href}>{link.label}</a>
				</li>
			))
		}
	</ul>
</nav>
