---
import { Image } from 'astro:assets'

interface Props {
	title: string
	description: string
	pagesLinks: {
		languages_code: string
		name: string
		slug: string
	}[]
}

const { title, description, pagesLinks } = Astro.props
const { t } = Astro.locals
const { locale } = Astro.params
const links = [
	{ locale, slug: '', label: t('index.header') },
	{ locale, slug: 'blog', label: t('blog.header') },
	...pagesLinks.map(({ languages_code: locale, slug, name: label }) => ({ locale, slug, label })),
]
---

<nav
	id="navbar"
	class="transition-all duration-500
		flex flex-col flex-none items-center
		w-64 h-screen p-4 pt-8
		bg-primary text-white
		absolute -left-64 top-0
		md:relative md:left-0"
>
	<Image
		loading="eager"
		src="https://placehold.co/96"
		class="rounded-full"
		width={96}
		height={96}
		alt={description}
	/>

	<h5 class="text-xl text-white pt-8">{title}</h5>
	<p class="text-xs text-center pt-4">{description}</p>

	<ul class="flex flex-col gap-4 text-center pt-8">
		{
			links.map((link) => (
				<li class="m-0">
					<a href={`/${link.locale}/${link.slug}`}>{link.label}</a>
				</li>
			))
		}
	</ul>
</nav>
